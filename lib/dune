(library
 (name blog_core)
 (libraries yocaml yocaml_markdown hilite textmate-language yojson))

; Embed the Scala TextMate grammar into the library at build time so the
; generator doesn't depend on the file being present at run time. The rule
; turns scala.tmLanguage.json into an OCaml module exposing it as a string.
(rule
 (target scala_grammar.ml)
 (deps scala.tmLanguage.json)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let json = {grammar|")
    (cat scala.tmLanguage.json)
    (echo "|grammar}\n")))))
